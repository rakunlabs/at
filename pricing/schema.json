{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AT Pricing provider file",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "models"],
  "properties": {
    "provider": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "price": {"type": ["number", "null"], "minimum": 0},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "source_url", "verified_at", "notes", "input", "output", "cache_read", "cache_write"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "verified_at": {"type": "string", "format": "date"},
        "notes": {"type": "string", "minLength": 1},
        "manual_only": {"type": "boolean"},
        "input": {"$ref": "#/$defs/price"},
        "output": {"$ref": "#/$defs/price"},
        "cache_read": {"$ref": "#/$defs/price"},
        "cache_write": {"$ref": "#/$defs/price"}
      }
    }
  }
}
